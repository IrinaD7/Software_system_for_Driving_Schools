<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DrivingSchoolApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DrivingSchoolApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DrivingSchoolApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">
                                Главная
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" data-bs-toggle="dropdown">
                                    Администрирование
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">Пользователи</a></li>
                                    <li><a class="dropdown-item" asp-controller="Application" asp-action="Index">Заявки</a></li>
                                    <li><a class="dropdown-item" asp-controller="StudyProgram" asp-action="Index">Учебные программы</a></li>
                                    <li><a class="dropdown-item" asp-controller="StudyGroup" asp-action="Index">Учебные группы</a></li>
                                    <li><a class="dropdown-item" asp-controller="Vehicle" asp-action="Index">Автомобили</a></li>
                                    <li><a class="dropdown-item" asp-controller="Teacher" asp-action="Index">Преподаватели</a></li>
                                    <li><a class="dropdown-item" asp-controller="Instructor" asp-action="Index">Инструкторы</a></li>
                                    <li><a class="dropdown-item" asp-controller="Student" asp-action="Index">Студенты</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Teacher"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" data-bs-toggle="dropdown">
                                    Преподаватель
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Lesson" asp-action="MySchedule">Моё расписание</a></li>
                                    <li><a class="dropdown-item" asp-controller="Attendance" asp-action="MyLessons">Посещаемость</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Instructor"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" data-bs-toggle="dropdown">
                                    Инструктор
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="DrivingLesson" asp-action="Index">Практические занятия</a></li>
                                    <li><a class="dropdown-item" asp-controller="Vehicle" asp-action="Index">Автомобили</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" data-bs-toggle="dropdown">
                                    Ученик
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Lesson" asp-action="MySchedule">Моё расписание</a></li>
                                    <li><a class="dropdown-item" asp-controller="Attendance" asp-action="MyAttendance">Посещаемость</a></li>
                                    <li><a class="dropdown-item" asp-controller="Exam" asp-action="MyResults">Экзамены</a></li>
                                </ul>
                            </li>
                        }

                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - DrivingSchoolApp
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
