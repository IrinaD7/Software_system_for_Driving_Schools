@model DrivingSchoolApp.Models.Admin.CreateUserViewModel

@{
	ViewData["Title"] = "Создание пользователя";
}

<h2>Создать пользователя</h2>

<form asp-action="CreateUser" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label asp-for="Email">Email</label><br />
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Роль</label><br />
        <select asp-for="Role" class="form-select form-select-lg mb-3">
            <option value="Admin">Администратор</option>
            <option value="Instructor">Инструктор</option>
            <option value="Teacher">Преподаватель</option>
            <option value="Student">Ученик</option>
        </select>
    </div>

    <div>
        <select asp-for="PersonId" class="form-select">
        @foreach(var p in ViewBag.Persons)
        {
            <option value="@p.Id">@p.Surname @p.Name</option>
        }
        </select>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Создать пользователя</button>
</form>