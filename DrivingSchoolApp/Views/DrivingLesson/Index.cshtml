@model IEnumerable<DrivingSchoolApp.Models.DrivingLesson>

<h2>Практические занятия</h2>

@if (User.IsInRole("Instructor"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Добавить занятие</a>
        <a asp-action="GradesReport" class="btn btn-secondary">Оценки</a>
    </p>
}


<table class="table">
    <thead>
        <tr>
            <th>Ученик</th>
            <th>Инструктор</th>
            <th>Автомобиль</th>
            <th>Дата</th>
            <th>Оценка</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Student?.Surname</td>
                <td>@item.Instructor?.Surname</td>
                <td>@item.Vehicle?.Model</td>
                <td>@item.Date</td>
                <td>@item.Grade</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary">Подробнее</a>
                    @if (User.IsInRole("Instructor"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">Редактировать</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Удалить</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>