@model DrivingSchoolApp.Models.AttendanceViewModel

<h2>Посещаемость</h2>

<form asp-action="Mark" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="LessonId" />

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Студент</th>
                <th>Присутствует</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Students.Count; i++)
            {
                <tr>
                    <td>
                        @Model.Students[i].FullName
                        <input type="hidden" asp-for="Students[i].StudentId" />
                        <input type="hidden" asp-for="Students[i].FullName" />
                    </td>
                    <td>
                        <input asp-for="Students[i].IsPresent" type="checkbox" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Сохранить</button>
</form>