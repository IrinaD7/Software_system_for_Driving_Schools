@model DrivingSchoolApp.Models.Application

<h2>Создать заявку</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label>Фамилия</label>
        <input asp-for="Surname" class="form-control" />
    </div>

    <div class="form-group">
        <label>Имя</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label>Отчество</label>
        <input asp-for="Patronymic" class="form-control" />
    </div>

    <div class="form-group">
        <label>Дата рождения</label>
        <input asp-for="BirthDate" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label>Паспорт</label>
        <input asp-for="Passport" class="form-control" />
        <span asp-validation-for="Passport" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Учебная программа</label>
        <select asp-for="StudyProgramId" class="form-control">
            @foreach (var p in ViewBag.Programs)
            {
                <option value="@p.Id">@p.Category</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Создать</button>
</form>
