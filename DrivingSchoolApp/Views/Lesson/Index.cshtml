@model IEnumerable<DrivingSchoolApp.Models.Lesson>

<h2>Теоретические занятия</h2>

<p>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">Добавить занятие</a>
        <a asp-action="CreateAuto" class="btn btn-primary">Автоматически создать занятия</a>
    }
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Преподаватель</th>
            <th>Группа</th>
            <th>Аудитория</th>
            <th>Дата и время</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Teacher?.Surname</td>
                <td>@item.Group?.Name</td>
                <td>@item.Classroom</td>
                <td>@item.Date</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Редактировать</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Удалить</a>
                    <a asp-controller="Attendance"
                       asp-action="Mark"
                       asp-route-lessonId="@item.Id"
                       class="btn btn-sm btn-warning">
                        Посещаемость
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>