@model DrivingSchoolApp.Models.StudyGroup

<h2>Студенты группы @Model.Name</h2>

<table class="table table-bordered">
	<thead>
		<tr>
			<th>Фамилия</th>
			<th>Имя</th>
			<th>Отчество</th>
			<th>Телефон</th>
		</tr>
	</thead>
	<tbody>
		@foreach(var student in Model.Students)
		{
			<tr>
				<td>
					@student.Surname 
				</td>
				<td>
					@student.Name
				</td>
				<td>
					@student.Patronymic
				</td>
				<td>
					@student.Phone
				</td>
			</tr>
		}
	</tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">К списку групп</a>